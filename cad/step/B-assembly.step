#157003 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#157004 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(5.E-04),#157001,
  'distance_accuracy_value','confusion accuracy');
#157005 = PRODUCT_RELATED_PRODUCT_CATEGORY('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
